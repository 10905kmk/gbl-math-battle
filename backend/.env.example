PORT=3000
ADMIN_PASSWORD=changeme
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# 실제 Gemini 연동(aiClient.js의 requestDamageRange/requestToolCalls)은 아직 스텁이라
# 항상 throw한다 — MOCK_AI=false로 실행하면 AI 채점은 매번 fallbackDamage로, AI 채팅은
# 매번 502로 떨어진다. 즉 부스 당일에는 MOCK_AI=true가 필수다(Opus 리뷰 Important #5 —
# 의도된 축소 범위, docs/superpowers/plans/2026-08-05-weapon-crafting.md의 "계획 축소"
# 커밋 참고). 실제 Gemini 연동이 붙기 전까지는 이 값을 false로 바꾸지 말 것.
GEMINI_API_KEYS=key1,key2,key3
MOCK_AI=true
